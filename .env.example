NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NIN_HASH_SALT=

# Cloudflare Turnstile (bot protection for Zed Mining daily claim)
# Get keys from https://dash.cloudflare.com → Turnstile
# In production, TURNSTILE_SECRET_KEY is required to claim $ZED.
# In development, leave blank to use the test keys automatically.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zed Funding Idea Submissions
# Salt used for one-way SHA-256 client IP hashing (required; fails closed if unset)
FUNDING_IP_SALT=

# Resend Email Configuration (best-effort dispatch for idea submissions)
RESEND_API_KEY=
FUNDING_FROM_EMAIL=Zed Funding <onboarding@resend.dev>
FUNDING_NOTIFY_EMAIL=thezedprojectng@gmail.com

# Verification Badges (optional feature flag: set to "true" to display verified badges, caution dialogs, and verification nudges)
NEXT_PUBLIC_SHOW_VERIFIED_BADGE=

